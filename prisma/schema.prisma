generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// 用户表
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  salt         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 一个用户可以有多个简历
  resumes      Resume[]
}

// 简历表
model Resume {
  id            Int      @id @default(autoincrement())
  userId        String
  resumeName    String
  resumeContext Json?
  size          Int
  score         Int?
  status        String   @default("上传中")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 每份简历属于一个用户
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId])
}
